.env*
# The template carries no secrets and must be tracked.
!.env.example

node_modules/
.vscode/
*.log

# Uploaded resumes and generated CVs
server/uploads/
server/tmp/

# Next.js build output
client/.next/
client/out/

# Python
__pycache__/
*.pyc
venv/
env/

# SQLite databases hold user resumes/history — never commit
*.db

# ResumeOptimiser (Resume-saas) is now vendored into this repo as regular files.
# Its own build/dependency/secret artefacts are covered by the rules above.
ResumeOptimiser/dist/
ResumeOptimiser/dist-ssr/

# Build artefacts / packaged extension
*.zip
*.exe
