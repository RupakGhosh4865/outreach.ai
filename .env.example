# Copy to .env and fill in. Never commit the filled-in file.

# ── Required: the server exits at boot if any of these are missing ───────────
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/outreachai
# Generate each with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Where the browser reaches the API (inlined into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Where the API sends users after OAuth
CLIENT_URL=http://localhost:3000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# High-volume extraction/classification
OPENAI_MODEL_FAST=gpt-4o-mini
# Emails and generated CVs — the things a human reads
OPENAI_MODEL_QUALITY=gpt-4o

# ── Email ────────────────────────────────────────────────────────────────────
# Shared fallback mailbox. Users who connect their own Google account send as
# themselves instead; see /api/auth/google/connect-gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn requires the "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Job / contact data ───────────────────────────────────────────────────────
HUNTER_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# ── Background jobs ──────────────────────────────────────────────────────────
# IMAP reply tracking is off by default.
ENABLE_REPLY_TRACKING=false
FOLLOW_UP_CRON=0 * * * *
SCHEDULED_SEND_CRON=* * * * *
